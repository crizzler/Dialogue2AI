# Keep this repository scoped to the Immersive NPCs asset.
# The surrounding Unity project contains local test scenes and third-party assets.
/Assets/*
!/Assets/ImmersiveNPCs/
!/Assets/ImmersiveNPCs.meta
/Packages/*
/ProjectSettings/*

# Unity generated project files
/*.csproj
/*.sln
/*.slnx
/*.pidb
/*.booproj
/*.svd
/*.user
/*.userprefs
/*.unityproj

